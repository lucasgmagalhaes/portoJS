{
  "name": "@portojs/core",
  "version": "0.8.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "Lucas Gomes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasgmagalhaes/portojs.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/lucasgmagalhaes/portojs/issues"
  },
  "homepage": "https://github.com/lucasgmagalhaes/portojs#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "description": "Game-agnostic primitives of PortoJS: big numbers, clock, fixed-timestep engine, events, offline math and versioned saves.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./bignum": {
      "import": {
        "types": "./dist/bignum.d.ts",
        "default": "./dist/bignum.js"
      },
      "require": {
        "types": "./dist/bignum.d.cts",
        "default": "./dist/bignum.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "bignum": [
        "./dist/bignum.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/build-cjs-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:package": "publint && attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  }
}
