{
  "name": "portojs",
  "version": "0.9.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "Lucas Gomes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasgmagalhaes/portojs.git",
    "directory": "packages/portojs"
  },
  "bugs": {
    "url": "https://github.com/lucasgmagalhaes/portojs/issues"
  },
  "homepage": "https://github.com/lucasgmagalhaes/portojs#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "description": "A headless TypeScript game engine with a Unity-style Game / GameObject / Component model and optional idle-game mechanics: big numbers, a stable tick loop, offline progress and versioned saves.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./bignum": {
      "import": {
        "types": "./dist/bignum.d.ts",
        "default": "./dist/bignum.js"
      },
      "require": {
        "types": "./dist/bignum.d.cts",
        "default": "./dist/bignum.cjs"
      }
    },
    "./idle": {
      "import": {
        "types": "./dist/idle.d.ts",
        "default": "./dist/idle.js"
      },
      "require": {
        "types": "./dist/idle.d.cts",
        "default": "./dist/idle.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "bignum": [
        "./dist/bignum.d.ts"
      ],
      "idle": [
        "./dist/idle.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/build-cjs-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:package": "publint && attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@portojs/core": "workspace:*",
    "@portojs/runtime": "workspace:*",
    "@portojs/idle": "workspace:*",
    "@portojs/react": "workspace:*",
    "@portojs/vue": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
