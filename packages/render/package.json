{
  "name": "@portojs/render",
  "version": "0.8.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "Lucas Gomes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasgmagalhaes/portojs.git",
    "directory": "packages/render"
  },
  "bugs": {
    "url": "https://github.com/lucasgmagalhaes/portojs/issues"
  },
  "homepage": "https://github.com/lucasgmagalhaes/portojs#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "description": "2D rendering for PortoJS: an orthographic camera, an auto-batching sprite renderer with WebGPU and WebGL2 backends and ECS integration.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/build-cjs-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:package": "publint && attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@portojs/ecs": "workspace:*"
  },
  "devDependencies": {
    "@portojs/core": "workspace:*",
    "@portojs/runtime": "workspace:*"
  }
}
