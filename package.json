{
  "name": "portojs-monorepo",
  "private": true,
  "version": "0.6.0",
  "description": "Monorepo of PortoJS packages.",
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.1",
    "lerna": "^10.1.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "tinybench": "^6.2.2",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.44"
  },
  "packageManager": "pnpm@10.34.7",
  "author": "Lucas Gomes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasgmagalhaes/portojs.git"
  },
  "bugs": {
    "url": "https://github.com/lucasgmagalhaes/portojs/issues"
  },
  "homepage": "https://github.com/lucasgmagalhaes/portojs#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "lerna run build",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "lerna run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx bench/tick.bench.ts",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "check:package": "lerna run check:package",
    "size": "size-limit",
    "api:check": "lerna run api:check",
    "api:update": "pnpm build && lerna run api:update",
    "e2e": "playwright test",
    "docs:api": "typedoc",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "size-limit": [
    {
      "name": "portojs/bignum",
      "path": "packages/portojs/dist/bignum.js",
      "import": "*",
      "limit": "3 KB"
    },
    {
      "name": "portojs/core",
      "path": "packages/portojs/dist/core.js",
      "import": "*",
      "limit": "9 KB"
    },
    {
      "name": "portojs (everything)",
      "path": "packages/portojs/dist/index.js",
      "import": "*",
      "limit": "16 KB"
    },
    {
      "name": "portojs/react",
      "path": "packages/portojs/dist/react.js",
      "import": "*",
      "limit": "3 KB",
      "ignore": [
        "react"
      ]
    },
    {
      "name": "portojs/vue",
      "path": "packages/portojs/dist/vue.js",
      "import": "*",
      "limit": "3 KB",
      "ignore": [
        "vue"
      ]
    }
  ]
}
