{
  "name": "leveling",
  "version": "1.0.0",
  "description": "Headless TypeScript engine for idle and incremental games: big numbers, stable ticks, offline progress, prestige and versioned saves.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.7",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx bench/tick.bench.ts",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "idle",
    "incremental",
    "game",
    "engine",
    "bignum",
    "offline",
    "prestige"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tinybench": "^6.2.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "author": "Lucas Gomes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasgmagalhaes/leveling.git"
  },
  "bugs": {
    "url": "https://github.com/lucasgmagalhaes/leveling/issues"
  },
  "homepage": "https://github.com/lucasgmagalhaes/leveling#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
