{
  "name": "portojs",
  "version": "0.5.0",
  "description": "A headless TypeScript game engine with a Unity-style Game / GameObject / Component model and optional idle-game mechanics: big numbers, a stable tick loop, offline progress and versioned saves.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.7",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./bignum": {
      "import": {
        "types": "./dist/bignum.d.ts",
        "default": "./dist/bignum.js"
      },
      "require": {
        "types": "./dist/bignum.d.cts",
        "default": "./dist/bignum.cjs"
      }
    },
    "./idle": {
      "import": {
        "types": "./dist/idle.d.ts",
        "default": "./dist/idle.js"
      },
      "require": {
        "types": "./dist/idle.d.cts",
        "default": "./dist/idle.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx bench/tick.bench.ts",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "size": "size-limit",
    "api:check": "api-extractor run",
    "api:update": "pnpm build && api-extractor run --local",
    "e2e": "playwright test",
    "docs:api": "typedoc",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "game",
    "engine",
    "headless",
    "component",
    "gameobject",
    "idle",
    "incremental",
    "bignum",
    "offline",
    "prestige"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "tinybench": "^6.2.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.44"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "author": "Lucas Gomes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasgmagalhaes/portojs.git"
  },
  "bugs": {
    "url": "https://github.com/lucasgmagalhaes/portojs/issues"
  },
  "homepage": "https://github.com/lucasgmagalhaes/portojs#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "bignum": [
        "./dist/bignum.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "idle": [
        "./dist/idle.d.ts"
      ]
    }
  },
  "size-limit": [
    {
      "name": "portojs/bignum",
      "path": "dist/bignum.js",
      "import": "*",
      "limit": "3 KB"
    },
    {
      "name": "portojs/core",
      "path": "dist/core.js",
      "import": "*",
      "limit": "8 KB"
    },
    {
      "name": "portojs (everything)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "14 KB"
    },
    {
      "name": "portojs/react",
      "path": "dist/react.js",
      "import": "*",
      "limit": "3 KB",
      "ignore": [
        "react"
      ]
    },
    {
      "name": "portojs/vue",
      "path": "dist/vue.js",
      "import": "*",
      "limit": "3 KB",
      "ignore": [
        "vue"
      ]
    }
  ],
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
