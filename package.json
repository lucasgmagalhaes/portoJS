{
  "name": "portojs",
  "version": "0.1.0",
  "description": "Headless TypeScript engine for idle and incremental games: big numbers, stable ticks, offline progress, prestige and versioned saves.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.7",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./bignum": {
      "import": {
        "types": "./dist/bignum.d.ts",
        "default": "./dist/bignum.js"
      },
      "require": {
        "types": "./dist/bignum.d.cts",
        "default": "./dist/bignum.cjs"
      }
    },
    "./mechanics": {
      "import": {
        "types": "./dist/mechanics.d.ts",
        "default": "./dist/mechanics.js"
      },
      "require": {
        "types": "./dist/mechanics.d.cts",
        "default": "./dist/mechanics.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx bench/tick.bench.ts",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "size": "size-limit",
    "api:check": "api-extractor run",
    "api:update": "pnpm build && api-extractor run --local",
    "e2e": "playwright test"
  },
  "keywords": [
    "idle",
    "incremental",
    "game",
    "engine",
    "bignum",
    "offline",
    "prestige"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tinybench": "^6.2.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "author": "Lucas Gomes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasgmagalhaes/portojs.git"
  },
  "bugs": {
    "url": "https://github.com/lucasgmagalhaes/portojs/issues"
  },
  "homepage": "https://github.com/lucasgmagalhaes/portojs#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "bignum": [
        "./dist/bignum.d.ts"
      ],
      "mechanics": [
        "./dist/mechanics.d.ts"
      ]
    }
  },
  "size-limit": [
    {
      "name": "portojs/bignum",
      "path": "dist/bignum.js",
      "import": "*",
      "limit": "3 KB"
    },
    {
      "name": "portojs/core",
      "path": "dist/core.js",
      "import": "*",
      "limit": "7 KB"
    },
    {
      "name": "portojs (everything)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "14 KB"
    }
  ]
}
