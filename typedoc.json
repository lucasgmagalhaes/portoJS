{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["packages/portojs/src/index.ts"],
  "tsconfig": "tsconfig.json",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "entryFileName": "index",
  "readme": "none",
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "githubPages": false,
  "cleanOutputDir": true,
  "name": "API reference"
}
