{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@portojs/core": ["./packages/core/src/index.ts"],
      "@portojs/core/bignum": ["./packages/core/src/bignum.ts"],
      "@portojs/runtime": ["./packages/runtime/src/index.ts"],
      "@portojs/idle": ["./packages/idle/src/index.ts"],
      "@portojs/react": ["./packages/react/src/index.ts"],
      "@portojs/vue": ["./packages/vue/src/index.ts"],
      "@portojs/svelte": ["./packages/svelte/src/index.ts"],
      "@portojs/solid": ["./packages/solid/src/index.ts"],
      "portojs": ["./packages/portojs/src/index.ts"],
      "@portojs/assets": ["./packages/assets/src/index.ts"],
      "@portojs/tween": ["./packages/tween/src/index.ts"],
      "@portojs/math": ["./packages/math/src/index.ts"],
      "@portojs/i18n": ["./packages/i18n/src/index.ts"],
      "@portojs/tilemap": ["./packages/tilemap/src/index.ts"],
      "@portojs/ecs": ["./packages/ecs/src/index.ts"],
      "@portojs/render": ["./packages/render/src/index.ts"],
      "@portojs/input": ["./packages/input/src/index.ts"],
      "@portojs/audio": ["./packages/audio/src/index.ts"],
      "@portojs/tools": ["./packages/tools/src/index.ts"],
      "@portojs/platform": ["./packages/platform/src/index.ts"],
      "@portojs/worker": ["./packages/worker/src/index.ts"],
      "@portojs/devtools": ["./packages/devtools/src/index.ts"],
      "@portojs/physics": ["./packages/physics/src/index.ts"]
    }
  },
  "include": [
    "./packages/*/src",
    "./packages/*/test",
    "bench",
    "e2e",
    "*.config.ts",
    "vite.library.ts",
    "./packages/*/vite.config.ts"
  ]
